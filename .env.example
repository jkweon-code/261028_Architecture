# Firebase 웹 앱 설정값 (README 7-2 참고). 비워 두면 로그인·토론 기능만 꺼집니다.
# 이 파일을 복사해 .env 를 만들고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
# Netlify에서는 Site configuration → Environment variables 에 같은 이름으로 입력합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2단계(Firebase 연동)에서 사용하는 설정값입니다. 1단계에서는 비워 두어도 됩니다.
# 이 파일을 복사해 .env 를 만들고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
# Netlify에서는 Site configuration → Environment variables 에 같은 이름으로 입력합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
